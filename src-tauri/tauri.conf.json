{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BlueTrace AI",
  "version": "1.0.0",
  "identifier": "ai.bluetrace.workstation",
  "build": {
    "beforeDevCommand": "npm --prefix ../frontend run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm --prefix ../frontend run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "BlueTrace AI - MEP Estimating Workstation",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 768,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:* https://api.meta.ai; img-src 'self' data: blob: http://127.0.0.1:*; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "externalBin": [
      "binaries/bluetrace-core"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNCRjQ4OTI0N0Q5MThFQzgKUldTQldKVDVwWmdTdmhQWjBGSllWemxHVW1uR1p5dE1Zblp2V1hKSlp6TkdWVGt3WXpBMFBRPT0K",
      "endpoints": [
        "https://releases.bluetrace.ai/desktop/windows/update.json"
      ]
    }
  }
}
